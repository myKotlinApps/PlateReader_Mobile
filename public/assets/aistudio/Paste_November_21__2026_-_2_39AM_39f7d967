  document.querySelectorAll('input[name="severity"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      document.querySelectorAll('#severitySelector label').forEach((label) => {
        label.classList.remove('bg-primary-fixed/30');
        label.classList.add('bg-surface-container-low');
      });
      const activeLabel = e.target.closest('label');
      if (activeLabel) {
        activeLabel.classList.remove('bg-surface-container-low');
        activeLabel.classList.add('bg-primary-fixed/30');
      }
    });
  });
